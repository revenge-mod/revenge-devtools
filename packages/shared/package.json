{
	"name": "@revenge-mod/devtools-shared",
	"version": "1.3.0",
	"type": "module",
	"license": "CC0-1.0",
	"scripts": {
		"build": "bunx tsdown --dts --treeshake --target esnext --platform neutral --tsconfig ../../tsconfig.json src/constants.ts src/logger.ts src/serializer.ts src/types.ts"
	},
	"files": [
		"README.md",
		"dist"
	],
	"exports": {
		"./types": {
			"types": "./dist/types.d.ts"
		},
		"./constants": {
			"default": "./dist/constants.js",
			"types": "./dist/constants.d.ts"
		},
		"./logger": {
			"default": "./dist/logger.js",
			"types": "./dist/logger.d.ts"
		},
		"./serializer": {
			"default": "./dist/serializer.js",
			"types": "./dist/serializer.d.ts"
		}
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"devalue": "^5.3.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"tsdown": "^0.15.7"
	}
}